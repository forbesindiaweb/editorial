  function selS(t,focus){tabs.forEach(function(x){var on=x===t;x.setAttribute('aria-selected',String(on));x.tabIndex=on?0:-1;});
    cur=+t.id.slice(2);cap.setAttribute('aria-labelledby',t.id);
    $$('.sc',vis).forEach(function(s){s.hidden=s.getAttribute('data-sc')!=String(cur)});if(focus)t.focus();play();}
  tabs.forEach(function(t,i){t.addEventListener('click',function(){selS(t)});
    t.addEventListener('keydown',function(e){var n=null,k=e.key;if(k==='ArrowRight')n=tabs[(i+1)%3];else if(k==='ArrowLeft')n=tabs[(i+2)%3];else if(k==='Home')n=tabs[0];else if(k==='End')n=tabs[2];if(n){e.preventDefault();selS(n,true);}});});
  stps.forEach(function(b){b.addEventListener('click',function(){stopAuto();show(+b.getAttribute('data-s'))})});
  $('#replay').addEventListener('click',play);
  show(0);onView([$('#play')],function(el,on,io){if(on){play();io&&io.unobserve(el);}},{threshold:.5});

  /* ---------- SCROLL 06 · finale ---------- */
  onView([$('#finale')],function(el,on,io){if(on){el.classList.add('in');io&&io.unobserve(el);}},{threshold:.2});
  $('#toTop').addEventListener('click',function(){window.scrollTo({top:0,behavior:reduce?'auto':'smooth'});});

  // optional height report to a parent page (harmless if unused)
  function post(){try{if(window.parent!==window)window.parent.postMessage({type:'n18-immersive-height',height:document.documentElement.scrollHeight},'*');}catch(e){}}
  window.addEventListener('load',post);window.addEventListener('resize',post);document.addEventListener('toggle',post,true);
})();
</script>
